---
/**
 * The image-led card used across the index, category and tag grids. The
 * thumbnail is the post's own OG card (`/og/[slug].png`) — generated at
 * build time from that post's real title and tags, never a stock photo or a
 * generic icon, so the grid stays honest about what it's showing.
 */
import type { CollectionEntry } from "astro:content";
import { formatDate, readingTime } from "../lib/post";
import { categoryFor } from "../lib/categories";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const minutes = readingTime(post.body ?? "");
const category = categoryFor(post.data.tags);
---

<article class="thumb-card group relative flex flex-col overflow-hidden rounded-xl border border-line bg-surface transition-[border-color,transform] duration-200 [transition-timing-function:var(--ease-out)] hover:border-line-lit hover:-translate-y-0.5">
  <div class="aspect-1200/630 w-full overflow-hidden border-b border-line bg-bg-alt">
    <img
      src={`/og/${post.id}.png`}
      {/* Empty alt is deliberate, not an oversight: this image is a generated title card whose text duplicates the heading right below it - a screen reader announcing it would just repeat the post title a second time. */}
      alt=""
      loading="lazy"
      width="1200"
      height="630"
      class="h-full w-full object-cover transition-transform duration-300 [transition-timing-function:var(--ease-out)] group-hover:scale-[1.02]"
    />
  </div>

  <div class="flex flex-1 flex-col p-5">
    <a
      href={`/category/${category.slug}`}
      class="relative z-10 inline-flex w-fit items-center gap-1.5 text-[0.74rem] font-medium tracking-tight text-accent transition-colors duration-150 hover:text-ink"
    >
      <span
        class="h-1.5 w-1.5 shrink-0 rounded-full"
        style={`background-color: ${category.color}`}
        aria-hidden="true"
      />{" "}
      {category.label}
    </a>

    <h2 class="mt-2 line-clamp-2 text-[1.08rem] font-semibold leading-snug tracking-tight text-balance">
      <a
        href={`/posts/${post.id}`}
        class="transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent"
      >
        {post.data.title}
      </a>
    </h2>

    <p class="mt-2 line-clamp-2 flex-1 text-[0.9rem] leading-relaxed text-muted">
      {post.data.description}
    </p>

    <div class="mt-4 flex items-center gap-2 text-[0.78rem] text-dim">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min</span>
    </div>
  </div>
</article>
