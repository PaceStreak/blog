---
/**
 * The latest post, given editorial weight instead of sitting in the same-size
 * row as the rest of the index. One large treatment, never repeated — this is
 * a hero unit, not a card template stamped across the page.
 */
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../lib/post";
import DateBlock from "./DateBlock.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const minutes = readingTime(post.body ?? "");
---

<article
  class="featured-post group relative flex flex-col gap-6 rounded-2xl border border-line bg-surface p-6 transition-[border-color,transform] duration-200 [transition-timing-function:var(--ease-out)] hover:border-line-lit sm:flex-row sm:gap-8 sm:p-9"
>
  <DateBlock date={post.data.date} class="datecard--lg hidden shrink-0 sm:flex" />

  <div class="min-w-0 flex-1">
    <p class="text-[0.78rem] font-medium tracking-tight text-dim">Latest</p>

    <h2 class="mt-2 text-[1.7rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
      <a
        href={`/posts/${post.id}`}
        class="transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent"
      >
        {post.data.title}
      </a>
    </h2>

    <p class="mt-3 max-w-[60ch] text-[1.02rem] leading-relaxed text-muted text-pretty">
      {post.data.description}
    </p>

    <div class="relative z-10 mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
      <time class="text-[0.82rem] text-dim sm:hidden" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
      </time>
      <span class="hidden text-[0.82rem] text-dim sm:inline">{minutes} min read</span>
      <span class="text-[0.82rem] text-dim sm:hidden">·</span>
      <span class="text-[0.82rem] text-dim sm:hidden">{minutes} min read</span>
      {
        post.data.tags.length > 0 && (
          <>
            <span aria-hidden="true" class="hidden text-line-lit sm:inline">
              /
            </span>
            <ul class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <li>
                  <a
                    href={`/tags/${tag}`}
                    class="inline-block rounded-full border border-line px-2.5 py-1 text-[0.76rem] text-dim transition-colors duration-150 hover:border-accent hover:text-accent"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>
</article>
