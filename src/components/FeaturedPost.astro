---
/**
 * The latest post, given editorial weight instead of sitting in the same-size
 * row as the rest of the index. One large treatment, never repeated — this is
 * a hero unit, not a card template stamped across the page. Leads with the
 * post's own OG card as a full-width image, the same honest-thumbnail rule
 * as PostGridCard: generated from this post's real content, not stock art.
 */
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../lib/post";
import { categoryFor } from "../lib/categories";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const minutes = readingTime(post.body ?? "");
const category = categoryFor(post.data.tags);
---

<article
  class="featured-post group relative overflow-hidden rounded-2xl border border-line bg-surface transition-[border-color,transform] duration-200 [transition-timing-function:var(--ease-out)] hover:border-accent/60 lg:flex lg:items-stretch"
>
  <div class="relative aspect-1200/630 w-full overflow-hidden border-b border-line bg-bg-alt lg:aspect-auto lg:w-[46%] lg:border-b-0 lg:border-r">
    <img
      src={`/og/${post.id}.png`}
      {/* Empty alt is deliberate, not an oversight: this image is a generated title card whose text duplicates the heading right below it - a screen reader announcing it would just repeat the post title a second time. */}
      alt=""
      loading="eager"
      fetchpriority="high"
      width="1200"
      height="630"
      class="h-full w-full object-cover transition-transform duration-300 [transition-timing-function:var(--ease-out)] group-hover:scale-[1.04]"
    />
    {
      /* A visible read-cue on the image itself, not just a near-imperceptible
         zoom — fades in with the same hover as the rest of the card, so the
         image half signals "clickable" as clearly as the text half does. */
    }
    <div
      class="pointer-events-none absolute inset-0 flex items-end bg-linear-to-t from-bg/70 via-transparent to-transparent opacity-0 transition-opacity duration-200 group-hover:opacity-100"
      aria-hidden="true"
    >
      <span class="m-5 inline-flex items-center gap-1.5 text-[0.82rem] font-medium text-ink">
        Read the post
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="transition-transform duration-200 group-hover:translate-x-0.5">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>

  <div class="min-w-0 flex-1 p-6 sm:p-9">
    <div class="flex items-center gap-2.5">
      <p class="text-[0.78rem] font-medium tracking-tight text-dim">Latest</p>
      <span aria-hidden="true" class="text-line-lit">/</span>
      <a
        href={`/category/${category.slug}`}
        class="relative z-10 inline-flex items-center gap-1.5 text-[0.78rem] font-medium tracking-tight text-accent transition-colors duration-150 hover:text-ink"
      >
        <span
          class="h-1.5 w-1.5 shrink-0 rounded-full"
          style={`background-color: ${category.color}`}
          aria-hidden="true"
        />{" "}
        {category.label}
      </a>
    </div>

    <h2 class="mt-3 text-[1.7rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
      <a
        href={`/posts/${post.id}`}
        class="transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent"
      >
        {post.data.title}
      </a>
    </h2>

    <p class="mt-3 max-w-[60ch] text-[1.02rem] leading-relaxed text-muted text-pretty">
      {post.data.description}
    </p>

    <div class="relative z-10 mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
      <time class="text-[0.82rem] text-dim" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
      </time>
      <span class="text-[0.82rem] text-dim">·</span>
      <span class="text-[0.82rem] text-dim">{minutes} min read</span>
      {
        post.data.tags.length > 0 && (
          <>
            <span aria-hidden="true" class="hidden text-line-lit sm:inline">
              /
            </span>
            <ul class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 4).map((tag) => (
                <li>
                  <a
                    href={`/tags/${tag}`}
                    class="inline-block rounded-full border border-line px-2.5 py-1 text-[0.76rem] text-dim transition-colors duration-150 hover:border-accent hover:text-accent"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>
</article>
