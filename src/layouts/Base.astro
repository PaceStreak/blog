---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/posts/foo". Defaults to the current URL. */
  path?: string;
  noindex?: boolean;
  /** Structured data. `application/ld+json` is data, not executable script,
      so `script-src 'self'` does not apply to it. */
  jsonLd?: unknown;
  /** Article pages set this so link previews show a date, not a website card. */
  ogType?: "website" | "article";
  publishedTime?: string;
  /** Absolute or root-relative; defaults to the site-wide card. */
  ogImage?: string;
}

const {
  title,
  description,
  path,
  noindex = false,
  jsonLd,
  ogType = "website",
  publishedTime,
  ogImage: ogImagePath,
} = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, Astro.site);
const ogImage = ogImagePath
  ? new URL(ogImagePath, Astro.site).href
  : "https://www.pacestreak.com/brand/social/og.png";
const year = new Date().getFullYear();

const nav = [
  { href: "/tags", label: "Tags" },
  { href: "/search", label: "Search" },
  { href: "https://www.pacestreak.com/features", label: "Features" },
  { href: "/rss.xml", label: "RSS" },
];
---

<!doctype html>
<html lang="en" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0b" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PaceStreak" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@PaceStreak" />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="PaceStreak Blog"
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body class="min-h-screen">
    <a class="skip" href="#main">Skip to content</a>

    <header
      class="site-header sticky top-0 z-50 border-b border-line/80 bg-bg/85 backdrop-blur-md"
    >
      <nav class="wrap-wide flex h-16 items-center justify-between gap-4" aria-label="Main">
        <a href="/" class="flex items-baseline gap-2 font-semibold tracking-tight">
          <span>Pace<span class="text-accent">Streak</span></span>
          <span class="text-[0.78rem] font-normal text-dim">blog</span>
        </a>
        <div class="flex items-center gap-0.5">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="hidden rounded-full px-3 py-1.5 text-[0.87rem] text-muted transition-colors duration-150 hover:bg-surface-2 hover:text-ink sm:inline-block"
              >
                {item.label}
              </a>
            ))
          }
          <a class="btn btn--sm ml-2" href="https://app.pacestreak.com/signup">Get started</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <section class="wrap-wide mt-20">
      <div class="cta-band flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            Build the habit. Keep the week.
          </h2>
          <p class="mt-2 max-w-xl text-muted">
            PaceStreak is a habit and streak tracker for training and everything else worth doing regularly.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn" href="https://app.pacestreak.com/signup">Get started free</a>
          <a class="btn btn--ghost" href="https://www.pacestreak.com/features">See the features</a>
        </div>
      </div>
    </section>

    <footer class="mt-16 border-t border-line bg-bg-alt py-12">
      <div class="wrap-wide grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
        <div>
          <p class="font-semibold">Pace<span class="text-accent">Streak</span> blog</p>
          <p class="mt-3 max-w-xs text-[0.92rem] text-dim">
            Building a habit and streak tracker in the open.
          </p>
        </div>
        <nav aria-label="Blog">
          <h2 class="text-[0.78rem] font-semibold tracking-[0.14em] text-dim uppercase">Read</h2>
          <ul class="mt-4 space-y-2.5 text-[0.94rem]">
            <li><a class="text-muted hover:text-ink" href="/">All posts</a></li>
            <li><a class="text-muted hover:text-ink" href="/tags">Tags</a></li>
            <li><a class="text-muted hover:text-ink" href="/search">Search</a></li>
            <li><a class="text-muted hover:text-ink" href="/rss.xml">RSS</a></li>
          </ul>
        </nav>
        <nav aria-label="Product">
          <h2 class="text-[0.78rem] font-semibold tracking-[0.14em] text-dim uppercase">Product</h2>
          <ul class="mt-4 space-y-2.5 text-[0.94rem]">
            <li><a class="text-muted hover:text-ink" href="https://www.pacestreak.com">PaceStreak</a></li>
            <li><a class="text-muted hover:text-ink" href="https://www.pacestreak.com/features">Features</a></li>
            <li><a class="text-muted hover:text-ink" href="https://www.pacestreak.com/faq">FAQ</a></li>
            <li><a class="text-muted hover:text-ink" href="https://app.pacestreak.com/signup">Get started</a></li>
          </ul>
        </nav>
        <nav aria-label="Company">
          <h2 class="text-[0.78rem] font-semibold tracking-[0.14em] text-dim uppercase">Company</h2>
          <ul class="mt-4 space-y-2.5 text-[0.94rem]">
            <li><a class="text-muted hover:text-ink" href="https://status.pacestreak.com">Status</a></li>
            <li><a class="text-muted hover:text-ink" href="https://github.com/PaceStreak" rel="noopener">GitHub</a></li>
            <li><a class="text-muted hover:text-ink" href="https://www.pacestreak.com/privacy">Privacy</a></li>
            <li><a class="text-muted hover:text-ink" href="https://www.pacestreak.com/terms">Terms</a></li>
          </ul>
        </nav>
      </div>
      <div class="wrap-wide mt-10 border-t border-line pt-6 text-[0.85rem] text-dim">
        <span>&copy; {year} PaceStreak</span>
      </div>
    </footer>
  </body>
</html>
