---
import Base from "../layouts/Base.astro";
import MarkX from "../components/MarkX.astro";

// Without this, Cloudflare Pages answers every unknown path with index.html and
// a 200. That is not just a soft 404 for search engines — before this page
// existed, /robots.txt returned the site's HTML, and Cloudflare concatenated it
// onto its own content-signals policy. Crawlers were being handed a robots.txt
// with a full HTML document inside it.
---

<Base
  title="Page not found — PaceStreak Blog"
  description="That page does not exist."
  path="/404"
  noindex
>
  <section class="wrap py-24 text-center sm:py-32">
    <MarkX size={30} class="mx-auto text-line-lit" />
    <h1 class="mt-6 text-[2.6rem] font-semibold tracking-tight sm:text-5xl">
      Nothing here.
    </h1>
    <p class="mx-auto mt-4 max-w-[28rem] text-muted text-pretty">
      That post or page doesn't exist. It may have been renamed, or the link may never
      have pointed anywhere.
    </p>

    <p class="footer-links mt-9 text-[0.95rem]">
      <a class="text-accent u-link" href="/">All posts</a>
      <a class="text-accent u-link" href="/tags">Tags</a>
      <a class="text-accent u-link" href="https://www.pacestreak.com">PaceStreak</a>
    </p>
  </section>
</Base>
