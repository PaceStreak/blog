---
import Base from "../layouts/Base.astro";

// Without this, Cloudflare Pages answers every unknown path with index.html and
// a 200. That is not just a soft 404 for search engines — before this page
// existed, /robots.txt returned the site's HTML, and Cloudflare concatenated it
// onto its own content-signals policy. Crawlers were being handed a robots.txt
// with a full HTML document inside it.
---

<Base
  title="Page not found — PaceStreak build log"
  description="That page does not exist."
  path="/404"
  noindex
>
  <section class="wrap py-24 text-center sm:py-32">
    <p class="text-[0.78rem] font-semibold tracking-[0.14em] text-dim uppercase">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
      Nothing here.
    </h1>
    <p class="mt-4 text-muted">
      That post or page doesn't exist. It may have been renamed, or the link may never
      have pointed anywhere.
    </p>

    <p class="footer-links mt-8 text-[0.95rem]">
      <a class="text-accent hover:underline" href="/">All posts</a>
      <a class="text-accent hover:underline" href="/tags">Tags</a>
      <a class="text-accent hover:underline" href="https://www.pacestreak.com"
        >PaceStreak</a
      >
    </p>
  </section>
</Base>
