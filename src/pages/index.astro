---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostGridCard from "../components/PostGridCard.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import CategoryNav from "../components/CategoryNav.astro";
import MarkX from "../components/MarkX.astro";
import Pager from "../components/Pager.astro";
import { paginate } from "../lib/pagination";

// Drafts are excluded from the index, the feed and the sitemap — set
// `draft: true` in a post's frontmatter to keep working on it in the open.
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// The front page is page 1 of the archive, not "every post ever written" —
// further pages live at /page/2, /page/3, ... (see src/pages/page/[page].astro,
// which shares this same paginate() helper so the two never drift apart on
// page size and so no post is ever skipped or duplicated between them).
const { items: posts, totalPages } = paginate(allPosts, 1);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "PaceStreak Blog",
  url: "https://blog.pacestreak.com",
  description:
    "Building a habit and streak tracker in the open. Notes on what broke, what it cost, and what I would do differently.",
  publisher: {
    "@type": "Organization",
    name: "PaceStreak",
    url: "https://www.pacestreak.com",
  },
};
---

<Base
  title="PaceStreak — Blog"
  description="Building a habit and streak tracker in the open. Notes on what broke, what it cost, and what I would do differently."
  path="/"
  jsonLd={jsonLd}
>
  <section class="wrap-wide pb-10 pt-14 sm:pb-12 sm:pt-20">
    <p class="kicker">
      <MarkX size={13} /> Building in the open
    </p>
    <h1 class="mt-5 max-w-4xl text-[clamp(2.6rem,6.5vw,4.75rem)] leading-[1] font-extrabold tracking-[-0.035em] text-balance">
      What broke, what it cost, and what changed.
    </h1>
    <p class="mt-6 max-w-2xl text-[1.1rem] leading-relaxed text-muted text-pretty">
      Notes from building{" "}
      <a class="text-accent u-link" href="https://www.pacestreak.com">PaceStreak</a>, a
      habit and streak tracker. Written as it happens rather than tidied up afterwards.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href="/search">Search the posts</a>
      <a class="btn btn--ghost" href="/rss.xml">Follow by RSS</a>
    </div>
  </section>

  <CategoryNav />

  <div class="wrap-wide py-10 sm:py-12">
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet. The first one is being written.</p>
      ) : (
        <>
          <FeaturedPost post={posts[0]} />

          {
            posts.length > 1 && (
              <ul class="mt-10 grid-cards">
                {posts.slice(1).map((post) => (
                  <li>
                    <PostGridCard post={post} />
                  </li>
                ))}
              </ul>
            )
          }

          <Pager currentPage={1} totalPages={totalPages} basePath="/" />
        </>
      )
    }
  </div>
</Base>
