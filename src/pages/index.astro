---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import MarkX from "../components/MarkX.astro";

// Drafts are excluded from the index, the feed and the sitemap — set
// `draft: true` in a post's frontmatter to keep working on it in the open.
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "PaceStreak Blog",
  url: "https://blog.pacestreak.com",
  description:
    "Building a habit and streak tracker in the open. Notes on what broke, what it cost, and what I would do differently.",
  publisher: {
    "@type": "Organization",
    name: "PaceStreak",
    url: "https://www.pacestreak.com",
  },
};
---

<Base
  title="PaceStreak — Blog"
  description="Building a habit and streak tracker in the open. Notes on what broke, what it cost, and what I would do differently."
  path="/"
  jsonLd={jsonLd}
>
  <section class="wrap pb-10 pt-16 sm:pb-12 sm:pt-20">
    <p class="kicker">
      <MarkX size={13} /> Building in the open
    </p>
    <h1 class="mt-4 text-[2.6rem] font-semibold tracking-tight text-balance sm:text-[3.4rem]">
      Blog
    </h1>
    <p class="mt-5 max-w-[36rem] text-[1.05rem] leading-relaxed text-muted text-pretty">
      Notes from building{" "}
      <a class="text-accent u-link" href="https://www.pacestreak.com">PaceStreak</a>, a
      habit and streak tracker. What broke, what it cost, and what I would do
      differently — written as it happens rather than tidied up afterwards.
    </p>
  </section>

  <div class="wrap pb-8">
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet. The first one is being written.</p>
      ) : (
        <ul class="grid gap-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      )
    }
  </div>
</Base>
