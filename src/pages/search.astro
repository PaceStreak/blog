---
import Base from "../layouts/Base.astro";
import MarkX from "../components/MarkX.astro";
import { categories } from "../lib/categories";
---

<Base
  title="Search — PaceStreak Blog"
  description="Search every post on the PaceStreak blog by title, topic or tag."
  path="/search"
>
  <section class="wrap py-14 sm:py-16">
    <p class="kicker">
      <MarkX size={13} /> Search
    </p>
    <h1 class="mt-4 text-[2.4rem] font-semibold tracking-tight sm:text-[2.8rem]">
      Search the blog
    </h1>

    <div class="relative mt-8 max-w-[36rem]">
      <label for="search-input" class="sr-only">Search posts</label>
      <input
        id="search-input"
        type="search"
        placeholder="Search by title, topic or tag…"
        autocomplete="off"
        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-[0.98rem] text-ink placeholder:text-dim focus-visible:border-accent focus-visible:outline-none"
      />
    </div>

    <p id="search-status" class="mt-4 text-[0.88rem] text-dim" aria-live="polite"></p>

    {
      /* Only shown by the script when a query returns nothing — a dead end
         with a text count and nowhere to go next is the one thing a search
         page shouldn't do. */
    }
    <div id="search-empty" class="mt-6 hidden">
      <p class="text-[0.9rem] text-muted">Try browsing instead:</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          categories.map((c) => (
            <li>
              <a
                href={`/category/${c.slug}`}
                class="category-pill border border-line"
              >
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="wrap pb-16">
    <ul id="search-results" class="grid gap-1"></ul>
  </div>
</Base>

<script>
  interface Entry {
    slug: string;
    title: string;
    description: string;
    tags: string[];
    category: string;
    date: string;
  }

  const input = document.getElementById("search-input") as HTMLInputElement;
  const status = document.getElementById("search-status") as HTMLParagraphElement;
  const results = document.getElementById("search-results") as HTMLUListElement;
  const empty = document.getElementById("search-empty") as HTMLDivElement;

  let entries: Entry[] = [];

  function resultRow(entry: Entry): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "border-b border-line last:border-b-0";

    const dateStr = new Date(entry.date).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });

    const a = document.createElement("a");
    a.href = `/posts/${entry.slug}`;
    a.className = "block py-5 transition-colors duration-150 hover:text-accent sm:py-6";

    const meta = document.createElement("span");
    meta.className = "text-[0.78rem] text-dim";
    meta.textContent = `${entry.category} · ${dateStr}`;

    const h2 = document.createElement("h2");
    h2.className = "mt-1 text-[1.1rem] font-semibold tracking-tight";
    h2.textContent = entry.title;

    const desc = document.createElement("p");
    desc.className = "mt-1 line-clamp-2 max-w-[52ch] text-[0.92rem] leading-relaxed text-muted";
    desc.textContent = entry.description;

    a.append(meta, h2, desc);
    li.append(a);
    return li;
  }

  function render(list: Entry[], query: string) {
    results.replaceChildren();

    if (query.trim() === "") {
      status.textContent = `${entries.length} posts indexed. Start typing to search.`;
      empty.classList.add("hidden");
      return;
    }

    status.textContent = `${list.length} result${list.length === 1 ? "" : "s"} for "${query}"`;
    empty.classList.toggle("hidden", list.length > 0);

    for (const entry of list) results.appendChild(resultRow(entry));
  }

  function search(query: string) {
    const q = query.trim().toLowerCase();
    if (q === "") return render([], "");

    const terms = q.split(/\s+/);
    const matches = entries.filter((entry) => {
      const haystack = `${entry.title} ${entry.description} ${entry.tags.join(" ")} ${entry.category}`.toLowerCase();
      return terms.every((term) => haystack.includes(term));
    });

    render(matches, query);
  }

  // A debounce, not because 44 posts needs one, but because a linear scan on
  // every keystroke is the kind of thing that's invisible now and a real
  // stutter once this index has grown past a few hundred entries — cheap to
  // add now, easy to forget once it's actually needed.
  let debounceHandle: ReturnType<typeof setTimeout> | undefined;
  function onInput() {
    clearTimeout(debounceHandle);
    debounceHandle = setTimeout(() => search(input.value), 120);
  }

  async function init() {
    status.textContent = "Loading…";
    const res = await fetch("/search-index.json");
    entries = await res.json();
    render([], "");

    const params = new URLSearchParams(location.search);
    const initial = params.get("q") ?? "";
    if (initial) {
      input.value = initial;
      search(initial);
    }
  }

  input?.addEventListener("input", onInput);
  init();
</script>
