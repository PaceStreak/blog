---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, readingTime } from "../../lib/post";
import { categoryFor } from "../../lib/categories";
import DateBlock from "../../components/DateBlock.astro";
import MarkX from "../../components/MarkX.astro";
import PostGridCard from "../../components/PostGridCard.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  // Previous/next and related posts are computed here, where the sorted list
  // already exists. Doing it inside the page would mean re-fetching and
  // re-sorting the whole collection once per post.
  return posts.map((post, index) => {
    // Related: most shared tags first, ties broken by recency. A post with
    // zero tag overlap is never "related" just because it's nearby in time —
    // that's what newer/older already cover.
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        post: p,
        shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .filter((r) => r.shared > 0)
      .sort((a, b) => b.shared - a.shared || b.post.data.date.valueOf() - a.post.data.date.valueOf())
      .slice(0, 3)
      .map((r) => r.post);

    return {
      params: { slug: post.id },
      props: {
        post,
        newer: posts[index - 1] ?? null,
        older: posts[index + 1] ?? null,
        related,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
  newer: CollectionEntry<"blog"> | null;
  older: CollectionEntry<"blog"> | null;
  related: CollectionEntry<"blog">[];
}

const { post, newer, older, related } = Astro.props;
const category = categoryFor(post.data.tags);
const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? "");
const url = new URL(`/posts/${post.id}`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  image: new URL(`/og/${post.id}.png`, Astro.site).href,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  keywords: post.data.tags.join(", "),
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  author: {
    "@type": "Organization",
    name: "PaceStreak",
    url: "https://www.pacestreak.com",
  },
  publisher: {
    "@type": "Organization",
    name: "PaceStreak",
    url: "https://www.pacestreak.com",
    logo: { "@type": "ImageObject", url: "https://www.pacestreak.com/brand/logo.svg" },
  },
};

// Only h2s. A table of contents that mirrors every h3 is longer than the
// section it points at.
const toc = headings.filter((h) => h.depth === 2);
---

<Base
  title={`${post.data.title} — PaceStreak Blog`}
  description={post.data.description}
  path={`/posts/${post.id}`}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  ogImage={`/og/${post.id}.png`}
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class="wrap-post py-12 sm:py-16">
    <a
      href="/"
      class="text-[0.88rem] text-dim transition-colors duration-150 hover:text-ink"
      >&larr; All posts</a
    >

    <header class="mt-7 flex gap-5 sm:gap-6">
      <DateBlock date={post.data.date} class="datecard--lg hidden sm:flex" />

      <div class="min-w-0 flex-1">
        <a
          href={`/category/${category.slug}`}
          class="relative z-10 text-[0.82rem] font-medium tracking-tight text-accent transition-colors duration-150 hover:text-ink"
        >
          {category.label}
        </a>

        <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.85rem] text-dim">
          <time class="sm:hidden" datetime={post.data.date.toISOString()}
            >{formatDate(post.data.date)}</time
          >
          <span aria-hidden="true" class="sm:hidden">·</span>
          <span>{minutes} min read</span>
        </div>

        <h1
          class="mt-3 max-w-[24ch] text-[2.1rem] font-semibold tracking-tight text-balance sm:text-[2.5rem]"
        >
          {post.data.title}
        </h1>

        <p class="mt-4 max-w-[58ch] text-lg leading-relaxed text-muted text-pretty">
          {post.data.description}
        </p>

        {
          post.data.tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li>
                  <a
                    href={`/tags/${tag}`}
                    class="inline-block rounded-full border border-line px-2.5 py-1 text-[0.78rem] text-dim transition-colors duration-150 hover:border-accent hover:text-accent"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <hr class="mt-8 border-line sm:mt-10" />

    <div class="post-layout mt-8 sm:mt-10">
      <div class="min-w-0">
        {
          toc.length > 2 && (
            <nav class="toc toc-inline mb-10 rounded-lg border border-line bg-surface p-5" aria-labelledby="toc-heading">
              <h2 id="toc-heading" class="kicker !text-[0.72rem]">
                <MarkX size={12} /> On this page
              </h2>
              <ol class="toc-list mt-3.5">
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`} class="text-[0.94rem]">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="article">
          <Content />
        </div>

        <div class="mt-12 flex items-center gap-3 border-t border-line pt-8">
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line bg-surface text-[0.85rem] font-semibold text-accent"
            aria-hidden="true"
          >
            AW
          </div>
          <div class="text-[0.88rem] leading-tight">
            <p class="font-medium text-ink">AlzyWelzy</p>
            <p class="text-dim">
              Building PaceStreak. <a class="u-link" href="https://github.com/PaceStreak">GitHub</a>
            </p>
          </div>
        </div>

        {
          related.length > 0 && (
            <div class="mt-12 border-t border-line pt-8">
              <h2 class="kicker !text-[0.72rem]">
                <MarkX size={12} /> Related
              </h2>
              <ul class="mt-5 grid gap-5 sm:grid-cols-3">
                {related.map((r) => (
                  <li>
                    <PostGridCard post={r} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          (newer || older) && (
            <nav
              class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
              aria-label="More posts"
            >
              {older ? (
                <a
                  href={`/posts/${older.id}`}
                  class="rounded-lg border border-line bg-surface p-4 transition-[border-color,transform] duration-200 [transition-timing-function:var(--ease-out)] hover:border-line-lit hover:-translate-y-0.5"
                >
                  <span class="kicker !text-[0.72rem]">&larr; Older</span>
                  <span class="mt-2 block font-medium text-pretty">{older.data.title}</span>
                </a>
              ) : (
                <span />
              )}

              {newer && (
                <a
                  href={`/posts/${newer.id}`}
                  class="rounded-lg border border-line bg-surface p-4 text-right transition-[border-color,transform] duration-200 [transition-timing-function:var(--ease-out)] hover:border-line-lit hover:-translate-y-0.5"
                >
                  <span class="kicker !text-[0.72rem] justify-end">Newer &rarr;</span>
                  <span class="mt-2 block font-medium text-pretty">{newer.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </div>

      {
        toc.length > 2 && (
          <nav class="toc toc-rail" aria-labelledby="toc-rail-heading">
            <h2 id="toc-rail-heading" class="kicker !text-[0.72rem]">
              <MarkX size={12} /> On this page
            </h2>
            <ol class="toc-list mt-3.5">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} class="text-[0.88rem]">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>
  </article>
</Base>
