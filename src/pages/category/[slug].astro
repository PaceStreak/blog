---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import PostGridCard from "../../components/PostGridCard.astro";
import { categories, categoryFor, topTagsForCategory } from "../../lib/categories";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      posts: posts.filter((p) => categoryFor(p.data.tags).slug === category.slug),
    },
  }));
}

interface Props {
  category: (typeof categories)[number];
  posts: CollectionEntry<"blog">[];
}

const { category, posts } = Astro.props;
---

<Base
  title={`${category.label} — PaceStreak Blog`}
  description={category.description}
  path={`/category/${category.slug}`}
>
  <CategoryNav current={category.slug} />

  <section class="wrap-wide py-14 sm:py-16">
    <h1 class="text-[2.4rem] font-semibold tracking-tight sm:text-[2.8rem]">
      {category.label}
    </h1>
    <p class="mt-4 max-w-[42rem] text-[1.02rem] leading-relaxed text-muted">
      {category.description}
    </p>
    <p class="mt-2 text-[0.85rem] text-dim">
      {posts.length} post{posts.length === 1 ? "" : "s"}.
    </p>

    {
      /* Categories and tags are two views of the same posts, not two
         competing systems — this is the connective tissue: every tag that
         actually shows up in this category, so a reader can narrow further
         without guessing which tag lives where. */
      posts.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {topTagsForCategory(posts.map((p) => p.data.tags)).map(({ tag, count }) => (
            <li>
              <a
                href={`/tags/${tag}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-[0.82rem] text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
              >
                {tag} <span class="text-dim">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <div class="wrap-wide pb-16">
    {
      posts.length === 0 ? (
        <p class="text-muted">Nothing here yet.</p>
      ) : (
        <ul class="grid-cards">
          {posts.map((post) => (
            <li>
              <PostGridCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
