---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostGridCard from "../../components/PostGridCard.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import { categoriesForPosts } from "../../lib/categories";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  const byTag = new Map<string, CollectionEntry<"blog">[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      byTag.set(tag, [...(byTag.get(tag) ?? []), post]);
    }
  }

  return [...byTag.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: { tag, posts: tagged },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<"blog">[];
}

const { tag, posts } = Astro.props;
const spannedCategories = categoriesForPosts(posts.map((p) => p.data.tags));
---

<Base
  title={`${tag} — PaceStreak Blog`}
  description={`Posts tagged ${tag} on the PaceStreak blog.`}
  path={`/tags/${tag}`}
>
  <CategoryNav />

  <section class="wrap-wide py-14 sm:py-16">
    <a
      href="/tags"
      class="text-[0.88rem] text-dim transition-colors duration-150 hover:text-ink"
      >&larr; All tags</a
    >
    <h1
      class="mt-5 text-[2.4rem] font-semibold tracking-tight before:text-dim before:content-['#'] sm:text-[2.8rem]"
    >
      {tag}
    </h1>
    <p class="mt-4 text-muted">
      {posts.length} post{posts.length === 1 ? "" : "s"}.
    </p>

    {
      /* The other half of the category<->tag connection: a tag isn't scoped
         to one category the way a post is, so this shows every category it
         actually shows up in rather than forcing a false one-to-one link. */
      spannedCategories.length > 0 && (
        <p class="mt-3 flex flex-wrap items-center gap-2 text-[0.85rem] text-dim">
          <span>In:</span>
          {spannedCategories.map((c) => (
            <a
              href={`/category/${c.slug}`}
              class="inline-flex items-center gap-1.5 text-muted transition-colors duration-150 hover:text-accent"
            >
              <span
                class="h-1.5 w-1.5 shrink-0 rounded-full"
                style={`background-color: ${c.color}`}
                aria-hidden="true"
              />{" "}
              {c.label}
            </a>
          ))}
        </p>
      )
    }
  </section>

  <div class="wrap-wide pb-16">
    <ul class="grid-cards">
      {posts.map((post) => <li><PostGridCard post={post} /></li>)}
    </ul>
  </div>
</Base>
