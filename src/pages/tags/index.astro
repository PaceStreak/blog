---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);

// Count first, then sort by count. An alphabetical list of tags tells you
// nothing about what this blog is actually about.
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<Base
  title="Tags — PaceStreak Blog"
  description="Every topic written about on the PaceStreak blog."
  path="/tags"
>
  <section class="wrap py-14 sm:py-16">
    <a href="/" class="text-[0.88rem] text-dim transition-colors hover:text-ink"
      >&larr; All posts</a
    >
    <h1 class="mt-6 text-4xl font-semibold tracking-tight">Tags</h1>
    <p class="mt-4 text-muted">
      {tags.length} topic{tags.length === 1 ? "" : "s"} across {posts.length} post{
        posts.length === 1 ? "" : "s"
      }.
    </p>

    {
      tags.length === 0 ? (
        <p class="mt-8 text-muted">Nothing tagged yet.</p>
      ) : (
        <ul class="mt-8 flex flex-wrap gap-2.5">
          {tags.map(([tag, count]) => (
            <li>
              <a
                href={`/tags/${tag}`}
                class="inline-flex items-center gap-2 rounded-[3px] border border-line bg-surface px-3.5 py-2 text-[0.92rem] transition-colors hover:border-accent hover:text-accent"
              >
                {tag} <span class="text-[0.8rem] text-dim">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
